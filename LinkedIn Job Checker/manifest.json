{
  "manifest_version": 3,
  "name": "LinkedIn Job Checker",
  "version": "2.3",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://dns.google/*",
    "https://html.duckduckgo.com/*",
    "https://corsproxy.io/*",
    "https://rdap.org/*",
    "*://*.ipwhoisinfo.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}